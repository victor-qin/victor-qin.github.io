---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/img/profile_photo.jpg';

const byDateDesc = (a: any, b: any) => b.data.date.valueOf() - a.data.date.valueOf();
const live = (e: any) => !e.data.draft;

const technical = (await getCollection('technical')).filter(live).sort(byDateDesc);
const work = (await getCollection('work')).filter(live).sort(byDateDesc);
---

<Base title="Victor Qin">
  <section class="hero">
    <div>
      <h1>Victor Qin</h1>
      <ul class="credentials">
        <li>PhD Candidate, AeroAstro, MIT</li>
        <li>SM AeroAstro, MIT 2023</li>
        <li>SB Electrical Engineering (Government secondary), Harvard 2021</li>
      </ul>

      <p>
        Hi! I'm currently a PhD Candidate in AeroAstro at MIT, under Prof. Hamsa
        Balakrishnan, where I study air traffic control methods for future aviation
        systems. This topic has led me into many different areas, including game
        theory, optimization, and reinforcement learning.
      </p>
      <p>
        I'm fortunate to be a NSF Graduate Research Fellow, and previously an NCCR
        Automation Fellow (at ETH Zurich) and a Mathworks Fellow.
      </p>
      <p>Always happy to talk about science fiction, take a trip, and play ultimate Frisbee!</p>

      <div class="linkrow">
        <a href="mailto:victorqi@mit.edu">Email</a>
        <a href="https://www.linkedin.com/in/victor-qin-14754286/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="/files/VictorQin_CV.pdf">CV</a>
        <a href="/files/VictorQin_resume.pdf">Résumé</a>
      </div>
    </div>

    <div class="hero-photo">
      <Image src={profilePhoto} alt="Victor Qin" widths={[260, 520]} sizes="(max-width: 720px) 200px, 260px" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Projects</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <ul class="grid">
      {technical.map((entry) => (
        <ProjectCard
          href={`/technical/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          date={entry.data.date}
        />
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Work</h2>
      <a href="/work/">All work →</a>
    </div>
    <ul class="grid">
      {work.map((entry) => (
        <ProjectCard
          href={`/work/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          date={entry.data.date}
          role={entry.data.role}
        />
      ))}
    </ul>
  </section>
</Base>
