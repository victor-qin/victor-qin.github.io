---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const entries = (await getCollection('technical'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Projects — Victor Qin" description="Technical projects and research by Victor Qin.">
  <h1>Projects</h1>
  <p class="lede">Technical and research work — air traffic management, multi-agent systems, and control.</p>

  <ul class="grid" style="margin-top: 2.5rem;">
    {entries.map((entry) => (
      <ProjectCard
        href={`/technical/${entry.id}/`}
        title={entry.data.title}
        description={entry.data.description}
        image={entry.data.image}
        date={entry.data.date}
      />
    ))}
  </ul>
</Base>
