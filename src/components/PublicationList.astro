---
import { SELF, type Publication } from '../data/publications.ts';

interface Props {
  items: Publication[];
}

const { items } = Astro.props;
---

<ol class="pubs">
  {items.map((p) => (
    <li class="pub">
      <div class="pub-gutter">
        <span class="pub-venue-short">{p.venueShort}</span>
        {p.toAppear && <span class="pub-toappear">(to appear)</span>}
        {p.pdf && <a class="pub-pdf" href={p.pdf}>pdf</a>}
      </div>

      <div class="pub-body">
        <h3 class="pub-title">
          {p.url ? <a href={p.url}>{p.title}</a> : p.title}
        </h3>

        <p class="pub-authors">
          {p.authors.map((a, i) => (
            <span class={a === SELF ? 'self' : undefined}
            >{a}{a === SELF && p.coFirst ? '*' : ''}{i < p.authors.length - 1 ? ',' : ''}</span>
          ))}
        </p>

        <p class="pub-venue">{p.venue}</p>
        {p.note && <p class="pub-note">{p.note}</p>}
      </div>
    </li>
  ))}
</ol>
