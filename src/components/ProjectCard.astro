---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  image?: ImageMetadata;
  date: Date;
  role?: string;
}

const { href, title, description, image, date, role } = Astro.props;
const year = date.getUTCFullYear();
---

<li>
  <a class="card" href={href}>
    {image ? (
      <div class="card-media">
        <Image
          src={image}
          alt=""
          widths={[320, 640, 960]}
          sizes="(max-width: 720px) 100vw, 340px"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="card-media card-media--empty" aria-hidden="true">{title.charAt(0)}</div>
    )}
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      <p class="card-meta">{role ? `${role} · ${year}` : year}</p>
    </div>
  </a>
</li>
